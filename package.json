{
    "name": "goomer-menu-api",
    "version": "1.0.0",
    "description": "Criar uma API capaz de gerenciar os produtos, promoções e o cardápio de um restaurante.",
    "main": "server.js",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "dev": "npm run services:up && tsx watch ./src/server.ts",
        "test": "npm run services:up && conc 'npm run dev' 'jest --watchAll --verbose'",
        "services:up": "docker compose -f docker-compose.yaml up -d",
        "lint:check": "eslint ./src ./test --ext .ts",
        "style:check": "prettier --check 'src/**/*.ts' 'test/**/*.ts'"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "module",
    "dependencies": {
        "fastify": "^5.6.1",
        "pg": "^8.16.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.38.0",
        "@types/async-retry": "^1.4.9",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.9.1",
        "@types/pg": "^8.15.5",
        "@typescript-eslint/eslint-plugin": "^8.46.2",
        "@typescript-eslint/parser": "^8.46.2",
        "async-retry": "^1.3.3",
        "concurrently": "^9.2.1",
        "eslint": "^9.38.0",
        "globals": "^16.4.0",
        "jest": "^29.7.0",
        "prettier": "^3.6.2",
        "ts-jest": "^29.4.5",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.2"
    }
}
